<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="container my-5">
    <div class="text-center mb-5">
      <span class="waybnb-badge"><i class="fa-solid fa-location-dot me-1"></i> Waybnb Stays</span>
      <h1 class="fw-bold mt-2">Explore Our Beautiful Homes</h1>
      <p class="text-muted">Handpicked stays, unique homes & unforgettable experiences</p>
    </div>

    <div class="row g-4">
      <% for(let listing of allListings) { %>
        <div class="col-lg-4 col-md-6 col-sm-12">
          <div class="card h-100 listing-card">
            <div class="image-wrapper">
              <img src="<%= listing.image.url %>" class="card-img-top listing-img" alt="<%= listing.title %>">
              <span class="price-badge">₹ <%= listing.price %> / night</span>
            </div>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text text-muted small mb-3">
                <i class="fa fa-map-marker-alt" style="color:#ff5a5f;"></i> <%= listing.location || "Unknown Location" %>
              </p>
              <div class="mt-auto">
                <a href="/listings/<%= listing._id %>" class="btn explore-btn w-100">Explore Home <i class="fa-solid fa-arrow-right ms-1"></i></a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>