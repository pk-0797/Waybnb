<% layout("/layouts/boilerplate.ejs") %>

<style>
  :root {
    --waybnb-primary: #ff5a5f;
    --waybnb-hover: #e04e53;
    --waybnb-dark: #222222;
    --waybnb-gray: #717171;
    --waybnb-border: #dddddd;
  }

  body {
    background: linear-gradient(135deg, #f7f7f7 0%, #e8e8e8 100%);
    min-height: 100vh;
  }

  .signup-container {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .signup-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    max-width: 420px;
    width: 100%;
    margin: auto;
  }

  .signup-header {
    background: linear-gradient(135deg, var(--waybnb-primary) 0%, #ff7b7f 100%);
    padding: 2rem;
    text-align: center;
    color: white;
  }

  .signup-header h2 {
    font-weight: 700;
    margin: 0;
    font-size: 1.75rem;
  }

  .signup-header p {
    margin: 0.5rem 0 0;
    opacity: 0.9;
    font-size: 0.95rem;
  }

  .signup-icon {
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .signup-icon svg {
    width: 30px;
    height: 30px;
    fill: white;
  }

  .signup-body {
    padding: 2rem;
  }

  .input-group {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--waybnb-gray);
    z-index: 10;
    transition: color 0.3s ease;
  }

  .form-control {
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    border: 2px solid var(--waybnb-border);
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.3s ease;
    background-color: #fafafa;
  }

  .form-control:focus {
    border-color: var(--waybnb-primary);
    box-shadow: 0 0 0 3px rgba(255, 90, 95, 0.15);
    background-color: white;
    outline: none;
  }

  .input-group:hover .input-icon,
  .form-control:focus ~ .input-icon {
    color: var(--waybnb-primary);
  }

  .btn-signup {
    background: linear-gradient(135deg, var(--waybnb-primary) 0%, #ff7b7f 100%);
    border: none;
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    color: white;
    width: 100%;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
  }

  .btn-signup:hover {
    background: linear-gradient(
      135deg,
      var(--waybnb-hover) 0%,
      var(--waybnb-primary) 100%
    );
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 90, 95, 0.35);
  }

  .btn-signup:active {
    transform: translateY(0);
  }

  .signup-footer {
    text-align: center;
    padding: 1.5rem 2rem 2rem;
    border-top: 1px solid var(--waybnb-border);
  }

  .signup-footer p {
    color: var(--waybnb-gray);
    margin: 0;
    font-size: 0.9rem;
  }

  .signup-footer a {
    color: var(--waybnb-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .signup-footer a:hover {
    color: var(--waybnb-hover);
    text-decoration: underline;
  }

  .password-toggle {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--waybnb-gray);
    cursor: pointer;
    padding: 0;
    z-index: 10;
    transition: color 0.3s ease;
  }

  .password-toggle:hover {
    color: var(--waybnb-primary);
  }

  @media (max-width: 480px) {
    .signup-container {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
      min-height: auto;
    }

    .signup-card {
      margin: 0 1rem;
      border-radius: 12px;
    }

    .signup-header {
      padding: 1.5rem;
    }

    .signup-header h2 {
      font-size: 1.5rem;
    }

    .signup-body {
      padding: 1.5rem;
    }

    .form-control {
      padding: 0.75rem 1rem 0.75rem 2.5rem;
      font-size: 0.95rem;
    }

    .btn-signup {
      padding: 0.75rem 1.25rem;
      font-size: 0.95rem;
    }
  }
</style>

<body>
  <div class="container signup-container">
    <div class="signup-card">
      <div class="signup-header">
        <div class="signup-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            />
          </svg>
        </div>
        <h2>Create Account</h2>
        <p>Join Waybnb and start exploring</p>
      </div>

      <div class="signup-body">
        <form action="/signup" method="post">
          <div class="input-group">
            <input
              type="text"
              name="username"
              placeholder="Enter your username"
              class="form-control"
              required
              autocomplete="username"
            />
            <span class="input-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"
                />
              </svg>
            </span>
          </div>

          <div class="input-group">
            <input
              type="email"
              name="email"
              placeholder="Enter your email"
              class="form-control"
              required
              autocomplete="email"
            />
            <span class="input-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 16 16"
              >
                <path
                  d="M.05 3.555A2 2 0 0 1 2 1.995h12a2 2 0 0 1 1.95 1.56L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"
                />
              </svg>
            </span>
          </div>

          <div class="input-group">
            <input
              type="password"
              name="password"
              id="password"
              placeholder="Enter your password"
              class="form-control"
              required
              autocomplete="new-password"
            />
            <span class="input-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"
                />
              </svg>
            </span>
            <button
              type="button"
              class="password-toggle"
              onclick="togglePassword()"
            >
              <svg
                id="eye-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 16 16"
              >
                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                <path
                  d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"
                />
              </svg>
            </button>
          </div>

          <button type="submit" class="btn-signup">Sign Up</button>
        </form>
      </div>

      <div class="signup-footer">
        <p>Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>

  <script>
    function togglePassword() {
      const passwordInput = document.getElementById("password");
      const eyeIcon = document.getElementById("eye-icon");

      if (passwordInput.type === "password") {
        passwordInput.type = "text";
        eyeIcon.innerHTML =
          '<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299l.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/><path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.413-.118 2.121-.322l.158.592z"/>';
      } else {
        passwordInput.type = "password";
        eyeIcon.innerHTML =
          '<path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/><path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>';
      }
    }
  </script>
</body>
