<style>
  :root {
    --waybnb-primary: #ff5a5f;
    --waybnb-hover: #e04e53;
    --waybnb-dark: #222222;
    --waybnb-gray: #717171;
    --waybnb-border: #dddddd;
  }

  .footer-waybnb {
    background: linear-gradient(135deg, #1f1f1f 0%, #2b2b2b 100%);
    color: #e8e8e8;
    padding: 2.5rem 0 1.75rem;
    margin-top: auto;
    position: relative;
  }

  .footer-waybnb::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--waybnb-primary),
      #ff8a8e,
      var(--waybnb-primary)
    );
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: #e8e8e8;
    font-size: 1.15rem;
    transition: all 0.3s ease;
  }

  .footer-social a:hover {
    background: var(--waybnb-primary);
    color: white;
    transform: translateY(-4px);
    box-shadow: 0 6px 18px rgba(255, 90, 95, 0.45);
  }

  .footer-copy {
    color: #a8a8a8;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }

  .footer-links a {
    color: #c8c8c8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    position: relative;
    transition: color 0.3s ease;
  }

  .footer-links a::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--waybnb-primary);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-links a:hover::after {
    width: 100%;
  }

  @media (max-width: 480px) {
    .footer-waybnb {
      padding: 2rem 0 1.5rem;
    }
    .footer-social a {
      width: 38px;
      height: 38px;
      font-size: 1rem;
    }
  }
</style>

<footer class="footer-waybnb mt-auto">
  <div class="container text-center">
    <div class="footer-social">
      <a href="#" aria-label="Facebook"
        ><i class="fa-brands fa-square-facebook"></i
      ></a>
      <a href="#" aria-label="Instagram"
        ><i class="fa-brands fa-square-instagram"></i
      ></a>
      <a href="#" aria-label="LinkedIn"
        ><i class="fa-brands fa-linkedin"></i
      ></a>
    </div>

    <small class="footer-copy d-block">&copy; WonderLust Private Limited</small>

    <div class="footer-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>
