<style>
  :root {
    --waybnb-primary: #ff5a5f;
    --waybnb-hover: #e04e53;
    --waybnb-dark: #222222;
    --waybnb-gray: #717171;
    --waybnb-border: #dddddd;
  }

  .navbar-waybnb {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--waybnb-border);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  }

  .navbar-waybnb .navbar-brand {
    color: var(--waybnb-dark);
    font-size: 1.35rem;
    letter-spacing: -0.5px;
    transition: transform 0.3s ease;
  }

  .navbar-waybnb .navbar-brand:hover {
    transform: scale(1.03);
  }

  .navbar-waybnb .brand-icon {
    color: var(--waybnb-primary);
  }

  .navbar-waybnb .nav-link {
    color: var(--waybnb-dark);
    font-weight: 500;
    position: relative;
    transition: color 0.3s ease;
    padding: 0.5rem 1rem !important;
  }

  .navbar-waybnb .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: var(--waybnb-primary);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .navbar-waybnb .nav-link:hover {
    color: var(--waybnb-primary);
  }

  .navbar-waybnb .nav-link:hover::after {
    width: 55%;
  }

  .btn-waybnb-outline {
    border: 2px solid var(--waybnb-primary);
    color: var(--waybnb-primary);
    font-weight: 600;
    border-radius: 10px;
    padding: 0.45rem 1.25rem;
    transition: all 0.3s ease;
  }

  .btn-waybnb-outline:hover {
    background: var(--waybnb-primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 90, 95, 0.3);
  }

  .btn-waybnb-solid {
    background: linear-gradient(135deg, var(--waybnb-primary) 0%, #ff7b7f 100%);
    border: none;
    color: white;
    font-weight: 600;
    border-radius: 10px;
    padding: 0.45rem 1.25rem;
    transition: all 0.3s ease;
  }

  .btn-waybnb-solid:hover {
    background: linear-gradient(135deg, var(--waybnb-hover) 0%, var(--waybnb-primary) 100%);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 90, 95, 0.35);
  }

  @media (max-width: 991.98px) {
    .navbar-waybnb .btn-responsive {
      width: 100%;
      margin: 0.35rem 0;
    }
  }

  @media (min-width: 992px) {
    .navbar-waybnb .btn-responsive {
      width: auto;
      margin: 0 0.4rem;
    }
  }

  .navbar-waybnb .dropdown-toggle {
    font-weight: 600;
  }

  .navbar-waybnb .dropdown-toggle .fa-circle-user {
    color: var(--waybnb-primary) !important;
    font-size: 1.4rem;
  }

  .dropdown-menu-waybnb {
    border: none;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12) !important;
    padding: 0.5rem;
    margin-top: 0.75rem !important;
    animation: dropdownFade 0.25s ease;
  }

  @keyframes dropdownFade {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-menu-waybnb .dropdown-item {
    border-radius: 8px;
    padding: 0.65rem 1rem;
    font-weight: 500;
    transition: all 0.25s ease;
  }

  .dropdown-menu-waybnb .dropdown-item:hover {
    background: rgba(255, 90, 95, 0.1);
  }

  .dropdown-menu-waybnb .dropdown-item.text-danger:hover {
    background: rgba(220, 53, 69, 0.1);
    color: #c0392b !important;
  }

  .navbar-toggler-waybnb {
    border: 2px solid var(--waybnb-border);
    border-radius: 10px;
    padding: 0.4rem 0.6rem;
    transition: all 0.3s ease;
  }

  .navbar-toggler-waybnb:focus {
    box-shadow: 0 0 0 3px rgba(255, 90, 95, 0.2);
    border-color: var(--waybnb-primary);
  }
</style>

<nav class="navbar navbar-expand-lg navbar-light navbar-waybnb sticky-top">
  <div class="container-fluid">
    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center" href="/listings">
      <i class="fa-regular fa-compass brand-icon fs-4 me-2"></i>
      <span class="fw-bold">Waybnb</span>
    </a>

    <!-- Toggler -->
    <button class="navbar-toggler navbar-toggler-waybnb" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left Nav -->
      <div class="navbar-nav me-auto">
        <a class="nav-link px-3" href="/listings">
          <i class="fa-solid fa-house me-1"></i> Explore
        </a>
        <a class="nav-link px-3" href="/listings/new">
          <i class="fa-solid fa-plus me-1"></i> Add Listing
        </a>
      </div>

      <!-- Right Nav -->
      <div class="navbar-nav ms-auto align-items-lg-center">
        <% if(!currUser) { %>
          <a class="btn btn-waybnb-outline btn-responsive text-nowrap" href="/signup">
            <i class="fa-solid fa-user-plus me-1"></i> Sign Up
          </a>
          <a class="btn btn-waybnb-solid btn-responsive text-nowrap" href="/login">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Log In
          </a>
        <% } %>

        <% if(currUser) { %>
          <!-- User Dropdown -->
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button"
              data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-circle-user me-1"></i>
              <span><%= currUser.username %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-waybnb dropdown-menu-end shadow-sm text-center text-lg-start"
              aria-labelledby="userDropdown">
              <li>
                <a class="dropdown-item text-danger" href="/logout">
                  <i class="fa-solid fa-right-from-bracket me-2"></i> Log Out
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>